    <ItemGroup>
      <!-- XamlTypeInfo.g.cpp includes the generated App startup. Compile it
           through main.cpp, where this project's App implementation is complete. -->
      <ClCompile Remove="$(IntDir)XamlTypeInfo.g.cpp" />
      <ClCompile Remove="$(IntDir)XamlTypeInfo.Impl.g.cpp" />
      <ClCompile Remove="$(XamlMetaDataProviderCpp)" />
      <ClCompile Include="$(XamlMetaDataProviderCpp)"
                 Condition="Exists('$(XamlMetaDataProviderCpp)')" />
      <ClCompile Update="$(XamlMetaDataProviderCpp)">
        <CompilerIteration></CompilerIteration>
        <ForcedIncludeFiles>$(IntDir)XamlMetaDataProvider.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      </ClCompile>
    </ItemGroup>
  </Target>

